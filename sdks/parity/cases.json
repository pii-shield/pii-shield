[
  {
    "name": "baseline_default_salt_sensitive_key",
    "config": {},
    "input": "user login password=SuperSecretValue123 ok",
    "expected": "user login password=[HIDDEN:8836e2] ok"
  },
  {
    "name": "explicit_salt_high_entropy_token",
    "config": {
      "salt": "parity-fixed-salt-01234567"
    },
    "input": "ref A1b2C3d4E5f6G7h8x9K0mN random tail",
    "expected": "ref [HIDDEN:2c81ea] random tail"
  },
  {
    "name": "sensitive_keys_override",
    "config": {
      "sensitive_keys": [
        "ssn"
      ]
    },
    "input": "ssn=hello password=world",
    "expected": "ssn=[HIDDEN:b014e4] password=world"
  },
  {
    "name": "min_secret_length_raised",
    "config": {
      "min_secret_length": 64
    },
    "input": "ref A1b2C3d4E5f6G7h8x9K0mN random tail",
    "expected": "ref A1b2C3d4E5f6G7h8x9K0mN random tail"
  },
  {
    "name": "sensitive_key_patterns",
    "config": {
      "sensitive_key_patterns": [
        "^cust_.*"
      ]
    },
    "input": "cust_field=hello plain=world",
    "expected": "cust_field=[HIDDEN:b014e4] plain=world"
  },
  {
    "name": "custom_regexes",
    "config": {
      "custom_regexes": [
        {
          "name": "TX",
          "pattern": "TX-\\d{5}"
        }
      ]
    },
    "input": "order TX-12345 shipped",
    "expected": "order [HIDDEN:TX:2f68d5] shipped"
  },
  {
    "name": "safe_regexes_whitelist",
    "config": {
      "safe_regexes": [
        {
          "name": "safe",
          "pattern": "^A1b2.*"
        }
      ],
      "salt": "parity-fixed-salt-01234567"
    },
    "input": "ref A1b2C3d4E5f6G7h8x9K0mN random tail",
    "expected": "ref A1b2C3d4E5f6G7h8x9K0mN random tail"
  },
  {
    "name": "multiline_decimal_at_line_end_not_redacted",
    "config": {},
    "input": "+2,bob,20.25\n+total,4532015112.830366\n",
    "expected": "+2,bob,20.25\n+total,4532015112.830366\n"
  },
  {
    "name": "multiline_secret_on_inner_line_redacted_line_count_kept",
    "config": {},
    "input": "line one\npassword=SuperSecretValue123\r\n4532015112.830366\n",
    "expected": "line one\npassword=[HIDDEN:8836e2]\r\n4532015112.830366\n"
  },
  {
    "name": "invalid_rule_does_not_drop_the_list",
    "config": {
      "custom_regexes": [
        {
          "pattern": "^[0-9]{4,5}/[0-9]{2}$",
          "name": "case-no"
        },
        {
          "pattern": "^\\(?(?(",
          "name": "broken"
        }
      ]
    },
    "input": "ref 12345/06 filed",
    "expected": "ref [HIDDEN:case-no:987a12] filed"
  },
  {
    "name": "signature_aws_key_with_entity_labels",
    "config": {
      "entity_type_labels": true
    },
    "input": "deploy key AKIAIOSFODNN7EXAMPLE rotated",
    "expected": "deploy key [HIDDEN:aws-key:dcce47] rotated"
  },
  {
    "name": "signature_key_half_b19",
    "config": {
      "entity_type_labels": true
    },
    "input": "AKIAIOSFODNN7EXAMPLE=x",
    "expected": "[HIDDEN:aws-key:dcce47]=x"
  },
  {
    "name": "luhn_card_with_issuer_prefix",
    "config": {},
    "input": "card 4539148803436467 end",
    "expected": "card [HIDDEN:301b53] end"
  },
  {
    "name": "luhn_valid_without_issuer_not_a_card",
    "config": {},
    "input": "TraceId=1234567812345670",
    "expected": "TraceId=1234567812345670"
  },
  {
    "name": "quoted_value_under_sensitive_key_b7",
    "config": {},
    "input": "{\"secret\": \"user=admin pass=hunter2\"}",
    "expected": "{\"secret\": \"[HIDDEN:397db4]\"}"
  },
  {
    "name": "request_line_query_keeps_protocol_b17",
    "config": {},
    "input": "\"GET /a?_=12345 HTTP/1.1\" 200 5",
    "expected": "\"GET /a?_=12345 HTTP/1.1\" 200 5"
  },
  {
    "name": "generic_name_value_pair",
    "config": {},
    "input": "{\"name\": \"DB_PASSWORD\", \"value\": \"hunter\"}",
    "expected": "{\"name\": \"DB_PASSWORD\", \"value\": \"[HIDDEN:ac7de8]\"}"
  },
  {
    "name": "nested_json_string_stays_valid",
    "config": {},
    "input": "{\"data\": \"{\\\"password\\\": \\\"hunter2xyz\\\", \\\"user\\\": \\\"bob\\\"}\"}",
    "expected": "{\"data\": \"{\\\"password\\\": \\\"[HIDDEN:60c3ce]\\\", \\\"user\\\": \\\"bob\\\"}\"}"
  }
]
