# Copy to .env and fill in. .env holds secrets: keep it on the server only,
# readable by root (chmod 600 .env), and out of any repository.

# The public name of the server; its DNS record points at this machine.
RULES_DOMAIN=rules.example.com

# The image. Pin the version you tested; see README.md, "Upgrade".
RULES_IMAGE=ghcr.io/pii-shield/pii-shield-rules:3.0.0

# invite: only addresses a member invited can sign in (start with this).
# open: any address can sign in and gets its own organization.
RULES_SIGNUP=invite

# Optional: a token for curl and for creating the first organization
# (openssl rand -hex 24). Leave empty once people sign in.
RULES_ADMIN_TOKEN=

# Mail for the sign-in links. 465 is TLS at once; 587 upgrades with STARTTLS.
RULES_SMTP_ADDR=smtp.example.com:587
RULES_SMTP_USER=rules@example.com
RULES_SMTP_PASSWORD=
RULES_MAIL_FROM=PII-Shield rules <rules@example.com>

# The bucket the database is copied to. For Cloudflare R2:
#   LITESTREAM_REPLICA_URL=s3://<bucket>/rules
#   LITESTREAM_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#   LITESTREAM_REGION=auto
LITESTREAM_REPLICA_URL=s3://my-bucket/rules
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
